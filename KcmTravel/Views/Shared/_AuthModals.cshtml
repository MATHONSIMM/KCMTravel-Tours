@{ var site = SiteOptions.Value; }

<template id="tpl-signin">
    <div class="signin" data-signin>
        <form class="signin-step" data-step-password novalidate>
            <div class="field">
                <label>Email or username</label>
                <input type="text" name="email" autocomplete="username" autocapitalize="none" spellcheck="false" placeholder="you@example.com or your username" required />
            </div>
            <div class="field">
                <label>Password</label>
                <div class="pw-wrap"><input type="password" name="password" autocomplete="current-password" required /><button type="button" class="pw-toggle" data-pw-toggle aria-label="Show password">Show</button></div>
            </div>
            <button class="btn btn--primary btn--block" type="submit">Sign in</button>
            <p class="signin-links"><button type="button" class="link-btn" data-forgot>Forgot or set password?</button></p>
        </form>
        <form class="signin-step" data-step-email novalidate hidden>
            <p class="signin-sent">Enter your email and we'll send a 6-digit code so you can choose a new password. KCM team members use this the first time too.</p>
            <div class="field">
                <label>Email address</label>
                <input type="email" name="email" autocomplete="email" inputmode="email" placeholder="you@example.com" required />
            </div>
            <button class="btn btn--primary btn--block" type="submit">Email me a code</button>
            <p class="signin-links"><button type="button" class="link-btn" data-back-password>Back to sign in</button></p>
        </form>
        <form class="signin-step" data-step-code novalidate hidden>
            <p class="signin-sent">We sent a code to <strong data-sent-to></strong>. Check your inbox (and spam folder).</p>
            <div class="field">
                <label>6-digit code</label>
                <input class="code-input" type="text" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" placeholder="••••••" required />
            </div>
            <div class="field">
                <label>New password</label>
                <div class="pw-wrap"><input type="password" name="password" autocomplete="new-password" minlength="10" required /><button type="button" class="pw-toggle" data-pw-toggle aria-label="Show password">Show</button></div>
                <p class="field-hint">At least 10 characters, with letters and a number.</p>
            </div>
            <button class="btn btn--primary btn--block" type="submit">Save password &amp; sign in</button>
            <p class="signin-links"><button type="button" class="link-btn" data-change-email>Use a different email</button> · <button type="button" class="link-btn" data-resend>Resend code</button></p>
        </form>
        <form class="signin-step" data-step-newpw novalidate hidden>
            <p class="signin-sent"><strong data-newpw-hi>Welcome.</strong> You signed in with a temporary password. Choose your own password now. Only you will know it.</p>
            <div class="field">
                <label>New password</label>
                <div class="pw-wrap"><input type="password" name="password" autocomplete="new-password" minlength="10" required /><button type="button" class="pw-toggle" data-pw-toggle aria-label="Show password">Show</button></div>
                <p class="field-hint">At least 10 characters, with letters and a number. Not the temporary password.</p>
            </div>
            <div class="field">
                <label>Type it again</label>
                <input type="password" name="password2" autocomplete="new-password" minlength="10" required />
            </div>
            <button class="btn btn--primary btn--block" type="submit">Save my password</button>
        </form>
        <form class="signin-step" data-step-mfa novalidate hidden>
            <p class="signin-sent"><strong>Two-step verification.</strong> Open your authenticator app (Google Authenticator, Microsoft Authenticator…) and enter the 6-digit code for KCM Travel &amp; Tours.</p>
            <div class="field" data-mfa-code-wrap>
                <label>Authenticator code</label>
                <input class="code-input" type="text" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" placeholder="••••••" />
            </div>
            <div class="field" data-mfa-recovery-wrap hidden>
                <label>Recovery code</label>
                <input type="text" name="recovery" autocomplete="off" maxlength="12" placeholder="XXXXX-XXXXX" />
            </div>
            <button class="btn btn--primary btn--block" type="submit">Verify</button>
            <p class="signin-links"><button type="button" class="link-btn" data-mfa-use-recovery>Lost your phone? Use a recovery code</button></p>
        </form>
        <form class="signin-step" data-step-mfa-setup novalidate hidden>
            <p class="signin-sent"><strong>Protect your account.</strong> Your role can see customer and payment information, so KCM requires a second step when you sign in.</p>
            <ol class="mfa-steps">
                <li>Install <strong>Google Authenticator</strong> or <strong>Microsoft Authenticator</strong> on your phone.</li>
                <li>In the app, tap <strong>+</strong> and scan this code (or type the key below).</li>
            </ol>
            <div class="mfa-qr" data-mfa-qr aria-label="QR code for your authenticator app"></div>
            <p class="mfa-key">Key: <code data-mfa-secret></code> <button type="button" class="link-btn" data-copy-secret>Copy</button></p>
            <div class="field">
                <label>3. Enter the 6-digit code the app shows</label>
                <input class="code-input" type="text" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" placeholder="••••••" />
            </div>
            <button class="btn btn--primary btn--block" type="submit">Turn on two-step verification</button>
        </form>
        <div class="signin-step" data-step-recovery hidden>
            <p class="signin-sent"><strong>Save your recovery codes.</strong> Each one works once if you lose your phone. Store them somewhere safe (a password manager or printed). They won't be shown again.</p>
            <ul class="recovery-codes" data-recovery-list></ul>
            <div class="btn-row"><button type="button" class="btn btn--ghost btn--sm" data-copy-recovery>Copy codes</button></div>
            <label class="check field"><input type="checkbox" data-recovery-ack /><span>I've saved my recovery codes.</span></label>
            <button class="btn btn--primary btn--block" type="button" data-recovery-done disabled>Continue</button>
        </div>
        <div class="signin-google" data-google-wrap hidden>
            <p class="signin-or"><span>or</span></p>
            <div data-google-btn></div>
        </div>
        <p class="form-error" role="alert" data-error hidden></p>
    </div>
</template>

<!-- ============ SIGN IN ============ -->
<dialog class="modal" id="signin-dialog" aria-labelledby="signin-title">
    <button class="modal-close" type="button" data-close aria-label="Close">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.3 5.7 12 12l6.3 6.3-1.4 1.4-6.3-6.3-6.3 6.3-1.4-1.4L9.2 12 2.9 5.7l1.4-1.4 6.3 6.3 6.3-6.3z"/></svg>
    </button>
    <div class="modal-inner">
        <img class="modal-logo" src="/images/brand/kcm-logo.svg" alt="" width="64" height="48" />
        <h2 class="modal-title" id="signin-title">Sign in</h2>
        <p class="modal-lead">For KCM partners and the KCM team.</p>
        <div class="notice notice--soft" data-api-missing hidden>Partner sign-in is being switched on. Please check back shortly.</div>
        <div data-signin-mount></div>
        <p class="modal-foot">New partner? <button type="button" class="link-btn" data-open-register>Register your business</button></p>
    </div>
</dialog>

<!-- ============ REGISTER ============ -->
<dialog class="modal modal--wide" id="register-dialog" aria-labelledby="register-title">
    <button class="modal-close" type="button" data-close aria-label="Close">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.3 5.7 12 12l6.3 6.3-1.4 1.4-6.3-6.3-6.3 6.3-1.4-1.4L9.2 12 2.9 5.7l1.4-1.4 6.3 6.3 6.3-6.3z"/></svg>
    </button>
    <div class="modal-inner">
        <p class="eyebrow">Partner programme</p>
        <h2 class="modal-title" id="register-title">Become a KCM partner</h2>
        <ol class="reg-progress" data-reg-progress aria-label="Registration steps">
            <li>Type</li><li>Business</li><li>Details</li><li>Photos</li><li>Documents</li><li>Account</li>
        </ol>
        <div class="notice notice--soft" data-api-missing hidden>Online partner registration is being switched on. You can look through the form now; submitting opens very soon.</div>

        <form class="reg-form" data-reg-form novalidate>
            <!-- 0: type -->
            <section class="reg-step" data-rstep="0">
                <p class="reg-lead">We work with a small number of carefully chosen partners: vehicle owners, guesthouses, lodges, guides and small agencies who meet a premium standard. Fill in the form, add photos and proof that the business is yours, choose a password and submit. Our team reviews every application.</p>
                <h3>What would you like to offer?</h3>
                <div class="type-grid" data-type-grid role="radiogroup" aria-label="Partner type"></div>
                <p class="reg-have">Already a partner? <button type="button" class="link-btn" data-open-signin>Sign in</button> to add another business.</p>
            </section>

            <!-- 1: business -->
            <section class="reg-step" data-rstep="1" hidden>
                <h3>About your business</h3>
                <div class="field-row">
                    <div class="field"><label for="r-contact">Your full name *</label><input id="r-contact" name="contactName" autocomplete="name" required /></div>
                    <div class="field"><label for="r-phone">Cell / WhatsApp *</label><input id="r-phone" name="phone" type="tel" autocomplete="tel" required placeholder="e.g. 082 123 4567" /></div>
                </div>
                <div class="field-row">
                    <div class="field"><label for="r-business">Business or trading name *</label><input id="r-business" name="businessName" required /></div>
                    <div class="field"><label for="r-reg">Company / CIPC reg. number</label><input id="r-reg" name="regNumber" placeholder="Optional" /></div>
                </div>
                <div class="field-row">
                    <div class="field"><label for="r-province">Province *</label>
                        <select id="r-province" name="province" required>
                            <option value="">Choose…</option>
                            <option>Mpumalanga</option><option>Limpopo</option><option>Gauteng</option><option>KwaZulu-Natal</option><option>Western Cape</option>
                            <option>Eastern Cape</option><option>North West</option><option>Free State</option><option>Northern Cape</option>
                        </select>
                    </div>
                    <div class="field"><label for="r-city">Town / city *</label><input id="r-city" name="city" required placeholder="e.g. Mbombela" /></div>
                </div>
                <div class="field-row">
                    <div class="field"><label for="r-years">Years in business</label>
                        <select id="r-years" name="years"><option value="">Choose…</option><option>Just starting</option><option>1–2 years</option><option>3–5 years</option><option>6–10 years</option><option>10+ years</option></select>
                    </div>
                    <div class="field"><label for="r-web">Website or social page</label><input id="r-web" name="website" placeholder="Optional" /></div>
                </div>
                <fieldset class="field" data-services-wrap>
                    <legend class="field-legend">Services you can offer *</legend>
                    <div class="check-grid" data-services></div>
                </fieldset>
                <div class="field"><label for="r-desc">Tell us about your business *</label><textarea id="r-desc" name="description" required maxlength="2000" placeholder="What makes your service premium? Where do you operate? Who are your typical guests?"></textarea></div>
            </section>

            <!-- 2: details -->
            <section class="reg-step" data-rstep="2" hidden>
                <h3 data-details-title>Details</h3>
                <div class="details-grid" data-details></div>
            </section>

            <!-- 3: photos -->
            <section class="reg-step" data-rstep="3" hidden>
                <h3>Photos</h3>
                <p class="reg-lead" data-photo-lead>Clear, recent photos in good light. Photos are private and only seen by the KCM review team.</p>
                <div class="photo-grid" data-photo-grid></div>
                <p class="field-hint">JPG, PNG or WebP. Large photos are resized on your device before upload to save data. On a phone you can take the photo straight from the camera.</p>
            </section>

            <!-- 4: documents -->
            <section class="reg-step" data-rstep="4" hidden>
                <h3>Proof that it's yours</h3>
                <p class="reg-lead">To protect our guests, we check that every vehicle or property belongs to the person applying (or that you're allowed to run it). Upload a PDF or a clear photo of each document. Documents are stored privately and only the KCM review team can see them.</p>
                <div class="doc-list" data-doc-list></div>
            </section>

            <!-- 5: account & submit -->
            <section class="reg-step" data-rstep="5" hidden>
                <h3>Create your login and submit</h3>
                <div data-reg-account>
                    <p class="reg-lead">You'll use this email and password to sign in to your partner portal once your application is approved.</p>
                    <div class="field"><label for="r-email">Email address *</label><input id="r-email" name="email" type="email" autocomplete="email" inputmode="email" required placeholder="you@example.com" /></div>
                    <div class="field-row">
                        <div class="field"><label for="r-pw">Password *</label><div class="pw-wrap"><input id="r-pw" name="password" type="password" autocomplete="new-password" minlength="10" required /><button type="button" class="pw-toggle" data-pw-toggle aria-label="Show password">Show</button></div></div>
                        <div class="field"><label for="r-pw2">Confirm password *</label><input id="r-pw2" name="password2" type="password" autocomplete="new-password" required /></div>
                    </div>
                    <p class="field-hint">At least 10 characters, with letters and a number.</p>
                </div>
                <p class="reg-signed" data-reg-signed hidden>Submitting as <strong data-reg-email></strong>.</p>
                <div class="hp" aria-hidden="true"><input name="hpWebsite" tabindex="-1" autocomplete="off" /></div>
                <h3 class="reg-sub">Your application</h3>
                <dl class="facts" data-reg-review></dl>
                <label class="check field"><input type="checkbox" name="accurate" /><span>The information, photos and documents are accurate, current and belong to my business.</span></label>
                <label class="check field"><input type="checkbox" name="consent" /><span>I agree that KCM Travel &amp; Tours may store and review my details, photos and documents to assess my application, as described in the <a href="/privacy" target="_blank">privacy notice</a> (POPIA).</span></label>
                <div class="upload-progress" data-upload-progress hidden>
                    <div class="upload-bar"><span data-upload-bar></span></div>
                    <p data-upload-text>Uploading…</p>
                </div>
            </section>

            <!-- done -->
            <section class="reg-step reg-done" data-rstep="6" hidden>
                <div class="confirm-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="white" stroke-width="3"/></svg></div>
                <h3>Application submitted</h3>
                <p>Your reference is <strong data-reg-ref></strong>. Our team has been notified and we've emailed you a copy.</p>
                <p>We review every application, usually within 3 working days. As soon as you're approved, we'll email you and you can <strong>sign in with your email and password</strong> to open your partner portal.</p>
                <button class="btn btn--primary" type="button" data-close>Done</button>
            </section>

            <p class="form-error" role="alert" data-reg-error hidden></p>
            <div class="reg-nav" data-reg-nav>
                <button class="btn btn--ghost" type="button" data-reg-back>Back</button>
                <button class="btn btn--primary" type="button" data-reg-next>Next</button>
            </div>
        </form>
    </div>
</dialog>
