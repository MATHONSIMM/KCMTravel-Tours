@model ContactMessage
@{
    var site = SiteOptions.Value;
    ViewData["Title"] = "Contact KCM Travel & Tours: WhatsApp, Call or Email";
    ViewData["Description"] = $"Contact KCM Travel & Tours in Mbombela, Mpumalanga. WhatsApp or call {site.PhoneDisplay}, or send us a message. We reply within one working day.";
    ViewData["HeroHeader"] = true;
    var sent = TempData["ContactSent"] as string;
}

<partial name="_PageHero" model="@(("Contact", "Let's plan <em>something good.</em>", "WhatsApp is the quickest way to reach us. You can also call, email or send a message here. We reply within one working day.", Catalog.P.CanyonAerial))" />

<section class="section">
    <div class="container two-col">
        <div>
            <h2 class="section-title reveal" style="font-size: clamp(30px, 3.4vw, 44px)">Talk to a <em>real person.</em></h2>
            <div class="contact-cards">
                <a class="contact-card reveal" href="@site.WhatsAppLink("Hi KCM Travel & Tours!")" target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1s-.5-.1-.7.1-.8 1-.9 1.2-.3.2-.6.1a8.2 8.2 0 0 1-4.1-3.6c-.3-.5.3-.5.9-1.6.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6a1.1 1.1 0 0 0-.8.4 3.4 3.4 0 0 0-1.1 2.5 5.9 5.9 0 0 0 1.2 3.1 13.4 13.4 0 0 0 5.2 4.6c1.9.8 2.7.9 3.6.7a3.1 3.1 0 0 0 2-1.4 2.5 2.5 0 0 0 .2-1.4c-.1-.2-.3-.3-.7-.5zM12 21.8a9.8 9.8 0 0 1-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4A9.8 9.8 0 1 1 12 21.8zM12 0a12 12 0 0 0-10.3 18L0 24l6.2-1.6A12 12 0 1 0 12 0z"/></svg>
                    <div><strong>WhatsApp @site.PhoneDisplay</strong><span>The quickest reply, seven days a week</span></div>
                </a>
                <a class="contact-card reveal" href="tel:@site.Phone">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z"/></svg>
                    <div><strong>Call @site.PhoneDisplay</strong><span>@site.Hours</span></div>
                </a>
                <a class="contact-card reveal" href="mailto:@site.Email">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5z"/></svg>
                    <div><strong>@site.Email</strong><span>For quotes, invoices and group bookings</span></div>
                </a>
                <div class="contact-card reveal">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
                    <div><strong>@site.Area</strong><span>We collect from Mbombela, White River, Hazyview and KMIA</span></div>
                </div>
            </div>
            <iframe class="map-embed reveal" title="Map of Mbombela, Mpumalanga" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
                    src="https://maps.google.com/maps?q=Msogwaba%2C%20Mbombela&z=11&output=embed"></iframe>
        </div>

        <div>
            <div class="step-card reveal">
                <h2>Send us a message</h2>
                <p>Tell us where you'd like to go, when and how many of you there are.</p>
                @if (sent is not null)
                {
                    <p class="notice" role="status">Thanks, @sent! Your message is in. We'll get back to you within one working day.</p>
                }
                <form method="post" action="/contact" novalidate>
                    @Html.AntiForgeryToken()
                    <div class="field">
                        <label asp-for="Name">Your name</label>
                        <input asp-for="Name" autocomplete="name" required />
                        <span asp-validation-for="Name" class="field-validation-error"></span>
                    </div>
                    <div class="field-row">
                        <div class="field">
                            <label asp-for="Email">Email</label>
                            <input asp-for="Email" type="email" autocomplete="email" required />
                            <span asp-validation-for="Email" class="field-validation-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Phone">Cell (optional)</label>
                            <input asp-for="Phone" type="tel" autocomplete="tel" />
                        </div>
                    </div>
                    <div class="field">
                        <label asp-for="Message">Message</label>
                        <textarea asp-for="Message" required placeholder="We're a family of four looking at Kruger in July…"></textarea>
                        <span asp-validation-for="Message" class="field-validation-error"></span>
                    </div>
                    <div class="hp" aria-hidden="true"><label for="Website">Leave this empty</label><input asp-for="Website" tabindex="-1" autocomplete="off" /></div>
                    <p class="field-hint" style="margin-bottom: 18px">We use your details only to reply to you. See our <a href="/privacy">privacy notice</a>.</p>
                    <button class="btn btn--primary btn--block" type="submit">Send message</button>
                </form>
            </div>
        </div>
    </div>
</section>
