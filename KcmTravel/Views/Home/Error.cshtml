@model int
@{
    var notFound = Model == 404;
    ViewData["Title"] = notFound ? "Page not found" : "Something went wrong";
    ViewData["Description"] = "This page could not be found on KCM Travel & Tours.";
}
@section Head { <meta name="robots" content="noindex" /> }
<section class="error-page">
    <div>
        <p class="error-code">@(notFound ? "404" : "Oops")</p>
        <h1 class="section-title" style="margin: 0 auto 16px">@(notFound ? "This trail doesn't lead anywhere." : "Something went wrong on our side.")</h1>
        <p class="lead">@(notFound ? "The page may have moved. Let's get you back on the road." : "Please try again in a moment, or contact us on WhatsApp.")</p>
        <div class="btn-row" style="justify-content: center; margin-top: 30px">
            <a class="btn btn--primary" href="/">Back to home</a>
            <a class="btn btn--ghost" href="/tours">Browse tours</a>
        </div>
    </div>
</section>
