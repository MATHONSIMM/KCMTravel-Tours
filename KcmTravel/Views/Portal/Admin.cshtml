@{
    ViewData["Title"] = "Admin Dashboard";
    ViewData["Description"] = "KCM Travel & Tours admin dashboard.";
    ViewData["AppShell"] = true;
    ViewData["BodyClass"] = "page-admin";
}
@section Head {
    <meta name="robots" content="noindex, nofollow" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ops.css" asp-append-version="true" />
}

<div class="adm" data-admin>
    <aside class="adm-side" aria-label="Dashboard sections">
        <nav class="adm-nav" data-adm-nav>
            <p class="adm-nav-group" data-nav-group>KCM Operations Centre</p>
            <a href="#workspace" data-view="workspace" data-perm="ops.edit.own" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v12H4zM8 20h8M12 16v4"/></svg>My Workspace</a>
            <a href="#ops" data-view="ops" data-perm="ops.view.all" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 13h6V4H4zm0 7h6v-5H4zm10 0h6v-9h-6zm0-16v5h6V4z"/></svg>Operations Overview</a>
            <a href="#incoming" data-view="incoming" data-perm="ops.edit.own|ops.view.all" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v10h-5l-3 3-3-3H4zM8 8h8M8 11h5"/></svg>Incoming Enquiries <span class="adm-badge" data-badge="incoming" hidden></span></a>
            <a href="#unassigned" data-view="unassigned" data-perm="ops.view.all" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm-7 9a7 7 0 0 1 14 0M18 3l3 3M21 3l-3 3"/></svg>Unassigned Tickets <span class="adm-badge" data-badge="unassigned" hidden></span></a>
            <a href="#tickets" data-view="tickets" data-perm="ops.edit.own|ops.view.all" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>All Tickets</a>
            <a href="#mine" data-view="mine" data-perm="ops.edit.own" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 11l2 2 4-4M5 4h14v16H5z"/></svg>My Assigned Tickets</a>
            <a href="#tasks" data-view="tasks" data-perm="ops.edit.own|ops.view.all" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11M4 6l1 1 2-2M4 12l1 1 2-2M4 18l1 1 2-2"/></svg>Tasks &amp; Follow-ups <span class="adm-badge" data-badge="overdueTasks" hidden></span></a>
            <a href="#quotes" data-view="quotes" data-perm="ops.edit.own|ops.view.all" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h4"/></svg>Quotations <span class="adm-badge" data-badge="quoteApprovals" hidden></span></a>
            <a href="#opsbookings" data-view="opsbookings" data-perm="ops.edit.own|ops.view.all" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v14H4zM4 10h16M8 3v4M16 3v4M9 15l2 2 4-4"/></svg>Bookings</a>
            <a href="#payments" data-view="payments" data-perm="pay.view" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18v12H3zM3 11h18M7 15h3"/></svg>Payments <span class="adm-badge" data-badge="paymentsToVerify" hidden></span></a>
            <a href="#completed" data-view="completed" data-perm="ops.edit.own|ops.view.all" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l4 4L19 6"/></svg>Completed Orders</a>
            <a href="#workload" data-view="workload" data-perm="ops.workload" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>Employee Workload</a>
            <a href="#activity" data-view="activity" data-perm="audit.view" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h4l3-8 4 16 3-8h4"/></svg>Activity &amp; Audit History</a>
            <a href="#opssettings" data-view="opssettings" data-perm="ops.templates" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM19 12l2-1-1-3-2 .5-1.5-1.5L17 5l-3-1-1 2h-2l-1-2-3 1 .5 2L6 8.5 4 8l-1 3 2 1v0l-2 1 1 3 2-.5 1.5 1.5L7 19l3 1 1-2h2l1 2 3-1-.5-2 1.5-1.5 2 .5 1-3z"/></svg>Checklists &amp; statuses</a>
            <p class="adm-nav-group" data-nav-group>Website & partners</p>
            <a href="#overview" data-view="overview" data-perm="dashboard.view" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12l9-8 9 8M5 10v10h14V10"/></svg>Website overview</a>
            <a href="#applications" data-view="applications" data-perm="partners.view" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6"/></svg>Partner applications <span class="adm-badge" data-badge="pending" hidden></span></a>
            <a href="#partners" data-view="partners" data-perm="partners.view" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm-7 9a7 7 0 0 1 14 0M17 11a3 3 0 1 0 0-6M22 20a5 5 0 0 0-4-4.9"/></svg>Partners</a>
            <a href="#bookings" data-view="bookings" data-perm="bookings.view" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H8l-4 4z"/></svg>Website requests <span class="adm-badge" data-badge="newBookings" hidden></span></a>
            <a href="#payouts" data-view="payouts" data-perm="payouts.view" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18v12H3zM3 11h18M7 15h3"/></svg>Partner trips &amp; payouts</a>
            <a href="#ratings" data-view="ratings" data-perm="partners.view|ratings.moderate" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/></svg>Ratings</a>
            <a href="#messages" data-view="messages" data-perm="messages.view" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H8l-4 4z"/></svg>Messages</a>
            <a href="#users" data-view="users" data-perm="users.view" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/></svg>Users &amp; access</a>
        </nav>
        <div class="adm-side-foot" data-adm-sheet></div>
    </aside>

    <section class="adm-main" aria-live="polite">
        <header class="adm-top">
            <div>
                <p class="eyebrow" data-adm-eyebrow>Admin</p>
                <h1 class="adm-title" data-adm-title>Dashboard</h1>
            </div>
            <div class="adm-top-actions">
                <span class="sample-pill" data-sample-pill hidden>Sample data</span>
                <a class="btn btn--primary btn--sm" href="#intake" data-perm="ops.intake" hidden>+ Register enquiry</a>
                <div class="notif" data-notif hidden>
                    <button class="notif-btn" type="button" data-notif-btn aria-label="Notifications" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9a6 6 0 1 1 12 0c0 6 2 7 2 7H4s2-1 2-7M10 20a2 2 0 0 0 4 0"/></svg><span class="notif-count" data-notif-count hidden></span></button>
                    <div class="notif-panel" data-notif-panel hidden></div>
                </div>
                <button class="btn btn--ghost btn--sm" type="button" data-refresh>Refresh</button>
            </div>
        </header>
        <div class="adm-body" data-adm-body>
            <div class="adm-card"><p>Loading…</p></div>
        </div>
    </section>
</div>

<div class="adm-drawer" data-drawer hidden>
    <div class="adm-drawer-backdrop" data-drawer-close></div>
    <aside class="adm-drawer-panel" role="dialog" aria-modal="true" aria-labelledby="drawer-title">
        <button class="modal-close" type="button" data-drawer-close aria-label="Close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.3 5.7 12 12l6.3 6.3-1.4 1.4-6.3-6.3-6.3 6.3-1.4-1.4L9.2 12 2.9 5.7l1.4-1.4 6.3 6.3 6.3-6.3z"/></svg></button>
        <div data-drawer-body></div>
    </aside>
</div>

<div class="lightbox" data-lightbox hidden><button type="button" class="modal-close" data-lightbox-close aria-label="Close photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.3 5.7 12 12l6.3 6.3-1.4 1.4-6.3-6.3-6.3 6.3-1.4-1.4L9.2 12 2.9 5.7l1.4-1.4 6.3 6.3 6.3-6.3z"/></svg></button><img alt="" data-lightbox-img><p data-lightbox-cap></p></div>
<div class="chart-tip" data-tip hidden></div>
<dialog class="modal ops-modal" data-ops-modal aria-labelledby="ops-modal-title">
    <div class="modal-inner"><button class="modal-close" type="button" data-ops-modal-close aria-label="Close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.3 5.7 12 12l6.3 6.3-1.4 1.4-6.3-6.3-6.3 6.3-1.4-1.4L9.2 12 2.9 5.7l1.4-1.4 6.3 6.3 6.3-6.3z"/></svg></button><div data-ops-modal-body></div></div>
</dialog>

@section Scripts {
    <script src="~/js/ops.js" asp-append-version="true" defer></script>
    <script src="~/js/admin.js" asp-append-version="true" defer></script>
}
