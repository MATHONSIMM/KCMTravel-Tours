@{
    ViewData["Title"] = "Admin Dashboard";
    ViewData["Description"] = "KCM Travel & Tours admin dashboard.";
    ViewData["AppShell"] = true;
    ViewData["BodyClass"] = "page-admin";
}
@section Head {
    <meta name="robots" content="noindex, nofollow" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="adm" data-admin>
    <aside class="adm-side" aria-label="Dashboard sections">
        <nav class="adm-nav" data-adm-nav>
            <a href="#overview" data-view="overview"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 13h6V4H4zm0 7h6v-5H4zm10 0h6v-9h-6zm0-16v5h6V4z"/></svg>Overview</a>
            <a href="#applications" data-view="applications"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6"/></svg>Applications <span class="adm-badge" data-badge="pending" hidden></span></a>
            <a href="#partners" data-view="partners"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm-7 9a7 7 0 0 1 14 0M17 11a3 3 0 1 0 0-6M22 20a5 5 0 0 0-4-4.9"/></svg>Partners</a>
            <a href="#bookings" data-view="bookings"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v14H4zM4 10h16M8 3v4M16 3v4"/></svg>Bookings <span class="adm-badge" data-badge="newBookings" hidden></span></a>
            <a href="#messages" data-view="messages"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H8l-4 4z"/></svg>Messages</a>
            <a href="#users" data-view="users"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/></svg>Users &amp; access</a>
            <a href="#activity" data-view="activity"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h4l3-8 4 16 3-8h4"/></svg>Activity</a>
        </nav>
        <div class="adm-side-foot" data-adm-sheet></div>
    </aside>

    <section class="adm-main" aria-live="polite">
        <header class="adm-top">
            <div>
                <p class="eyebrow" data-adm-eyebrow>Admin</p>
                <h1 class="adm-title" data-adm-title>Dashboard</h1>
            </div>
            <div class="adm-top-actions">
                <span class="sample-pill" data-sample-pill hidden>Sample data</span>
                <button class="btn btn--ghost btn--sm" type="button" data-refresh>Refresh</button>
            </div>
        </header>
        <div class="adm-body" data-adm-body>
            <div class="adm-card"><p>Loading…</p></div>
        </div>
    </section>
</div>

<div class="adm-drawer" data-drawer hidden>
    <div class="adm-drawer-backdrop" data-drawer-close></div>
    <aside class="adm-drawer-panel" role="dialog" aria-modal="true" aria-labelledby="drawer-title">
        <button class="modal-close" type="button" data-drawer-close aria-label="Close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.3 5.7 12 12l6.3 6.3-1.4 1.4-6.3-6.3-6.3 6.3-1.4-1.4L9.2 12 2.9 5.7l1.4-1.4 6.3 6.3 6.3-6.3z"/></svg></button>
        <div data-drawer-body></div>
    </aside>
</div>

<div class="lightbox" data-lightbox hidden><button type="button" class="modal-close" data-lightbox-close aria-label="Close photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.3 5.7 12 12l6.3 6.3-1.4 1.4-6.3-6.3-6.3 6.3-1.4-1.4L9.2 12 2.9 5.7l1.4-1.4 6.3 6.3 6.3-6.3z"/></svg></button><img alt="" data-lightbox-img><p data-lightbox-cap></p></div>
<div class="chart-tip" data-tip hidden></div>

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true" defer></script>
}
