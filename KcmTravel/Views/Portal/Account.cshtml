@{
    ViewData["Title"] = "Partner Portal";
    ViewData["Description"] = "Your KCM Travel & Tours partner portal: application status, trips, payouts, statements and guest ratings.";
}
@section Head { <meta name="robots" content="noindex" /> }

<div class="booking-wrap account-wrap">
    <div class="container">
        <div class="booking-head">
            <p class="eyebrow">Partner portal</p>
            <h1>Your business <em>with KCM.</em></h1>
        </div>
        <div data-account-root aria-live="polite">
            <div class="step-card"><p>Loading…</p></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/account.js" asp-append-version="true" defer></script>
}
